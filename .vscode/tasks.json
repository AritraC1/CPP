{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build cpp-learning for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/run.sh",
            "args": [
                "cpp-learning",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build student-management-system for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/run.sh",
            "args": [
                "student-management-system",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
