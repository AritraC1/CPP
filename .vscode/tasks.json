{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/run.sh",
            "args": [
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
